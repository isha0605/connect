        "click": {
         "action": "Run Script",
         "event": "click",
         "script": "signupError.value = '';\nif (!signupFullName || !signupCompanyName || !signupEmail || !signupPassword) {\n  signupError.value = 'Please fill in all fields.';\n  return;\n}\nsignupSubmitting.value = true;\ncall('connect.api.signup_customer', {\n  full_name: signupFullName.value,\n  company_name: signupCompanyName.value,\n  email: signupEmail.value,\n  password: signupPassword.value,\n}).then(() => {\n  const params = new URLSearchParams(window.location.search);\n  window.location.href = params.get('redirect-to') || '/connect/find-partners';\n}).catch((err) => {\n  signupSubmitting.value = false;\n  signupError.value = (err && err.message) || 'Could not create your account. Please try again.';\n});"
